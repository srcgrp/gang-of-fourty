+.site-header { position: sticky; z-index: 100; top: 0; background: rgb(255 253 248 / 94%); border-bottom: 1px solid var(--line); backdrop-filter: blur(12px); }
+.announcement { margin: 0; padding: .35rem 1rem; overflow: hidden; color: white; background: linear-gradient(90deg, var(--green), var(--green-2), var(--green)); background-size: 200% 100%; font-size: .78rem; text-align: center; animation: announcement-flow 7s linear infinite; }
+.header-shell { display: grid; grid-template-columns: auto minmax(14rem, 1fr) auto; align-items: center; gap: 2rem; max-width: 75rem; margin-inline: auto; padding: .8rem 1.25rem; }
+.brand { display: flex; align-items: center; gap: .7rem; color: var(--green); }
+.brand-mark { width: 3rem; height: 3rem; }
+.brand span { display: grid; line-height: 1.35; }
+.brand strong { font-size: 1.25rem; }
+.brand small { color: var(--muted); font-size: .68rem; }
+.search { display: flex; align-items: center; min-width: 0; padding: .15rem .25rem .15rem .15rem; background: var(--surface); border: 1px solid transparent; border-radius: 999px; }
+.search:focus-within { border-color: var(--green-2); box-shadow: 0 0 0 4px rgb(40 121 90 / 12%); }
+.search input { width: 100%; padding: .65rem 1rem; color: var(--ink); background: transparent; border: 0; outline: 0; }
+.search button { width: 2.45rem; height: 2.45rem; padding: .65rem; color: white; background: var(--green); border: 0; border-radius: 50%; cursor: pointer; }
+.search svg, .cart svg { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
+.cart { display: flex; align-items: center; gap: .45rem; min-height: 2.8rem; padding: .55rem .8rem; color: var(--green); background: var(--lime); border-radius: 999px; }
+.cart svg { width: 1.25rem; }
+.cart strong { display: grid; place-items: center; width: 1.35rem; height: 1.35rem; color: white; background: var(--green); border-radius: 50%; font-size: .72rem; }
+.desktop-menu { display: flex; align-items: center; justify-content: center; gap: clamp(1rem, 4vw, 3.5rem); max-width: 75rem; min-height: 3.25rem; margin-inline: auto; padding-inline: 1.25rem; }
+.desktop-menu a { position: relative; color: #3d5049; font-size: .9rem; }
+.desktop-menu a::after { position: absolute; right: 0; bottom: -.2rem; width: 100%; height: 2px; content: ""; background: var(--green-2); transform: scaleX(0); transform-origin: right; transition: transform .2s ease; }
+.desktop-menu a:hover::after, .desktop-menu a:focus-visible::after { transform: scaleX(1); }
+.menu { display: none; max-width: 75rem; margin-inline: auto; padding-inline: 1.25rem; }
 
+main { max-width: 75rem; margin-inline: auto; padding: 1.5rem 1.25rem 6rem; }
+.hero { position: relative; display: grid; grid-template-columns: 1.05fr .95fr; align-items: center; min-height: 34rem; overflow: hidden; padding: clamp(2rem, 6vw, 5rem); background: #e7f0db; border-radius: 2rem; }
+.hero::before { position: absolute; inset: auto auto -9rem -7rem; width: 22rem; height: 22rem; content: ""; background: #f4c878; border-radius: 50%; opacity: .55; }
+.hero-copy { position: relative; z-index: 2; max-width: 35rem; }
+.eyebrow { margin: 0 0 .25rem; color: var(--green-2); font-size: .82rem; letter-spacing: .04em; }
+h1, h2, h3, p { text-wrap: pretty; }
+h1 { max-width: 13ch; margin: 0; font-size: clamp(2.5rem, 6vw, 5.3rem); line-height: 1.18; letter-spacing: -.04em; }
+.hero-copy > p:not(.eyebrow) { max-width: 50ch; margin-block: 1.3rem 1.8rem; color: #50675e; }
+.primary-action { display: inline-flex; align-items: center; gap: .6rem; min-height: 3.2rem; padding: .65rem 1.2rem; color: white; background: var(--green); border-radius: 999px; box-shadow: 0 10px 25px rgb(23 75 58 / 25%); transition: transform .2s ease, box-shadow .2s ease; }
+.primary-action:hover { transform: translateY(-3px); box-shadow: 0 16px 30px rgb(23 75 58 / 28%); }
+.hero-features { display: flex; flex-wrap: wrap; gap: .5rem 1.4rem; margin: 1.8rem 0 0; padding: 0; list-style: none; color: #496259; font-size: .78rem; }
+.hero-features li::before { content: "✓ "; color: var(--green-2); }
+.hero-visual { position: relative; min-height: 27rem; }
+.hero-visual img { position: absolute; inset: 7% 5% auto auto; width: 84%; height: 77%; object-fit: cover; border: .75rem solid rgb(255 255 255 / 60%); border-radius: 50% 38% 45% 36%; box-shadow: var(--shadow); transform: rotate(-3deg); }
+.hero-visual p { position: absolute; z-index: 2; bottom: 5%; right: -2%; display: grid; margin: 0; padding: .9rem 1.2rem; background: white; border-radius: 1rem; box-shadow: var(--shadow); }
+.hero-visual p strong { color: var(--green-2); }
+.hero-visual p span { color: var(--muted); font-size: .72rem; }
+.shape { position: absolute; z-index: 3; display: grid; place-items: center; width: 4.3rem; height: 4.3rem; background: white; border-radius: 50%; box-shadow: var(--shadow); font-size: 2.2rem; animation: float 4s ease-in-out infinite; }
+.shape-one { top: 0; right: 6%; }
+.shape-two { top: 42%; left: 0; animation-delay: -1.4s; }
+.shape-three { right: 3%; bottom: 4%; animation-delay: -2.7s; }
+
+.categories, .product-section { padding-top: 5rem; }
+.section-heading { display: flex; align-items: end; justify-content: space-between; gap: 1.5rem; margin-bottom: 1.4rem; }
+.section-heading h2 { margin: 0; font-size: clamp(1.7rem, 3vw, 2.5rem); line-height: 1.35; }
+.section-heading > p { max-width: 30rem; margin: 0; color: var(--muted); font-size: .9rem; }
+.category-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: .8rem; }
+.category-grid a { display: grid; justify-items: center; min-width: 0; padding: 1.25rem .5rem; background: white; border: 1px solid var(--line); border-radius: 1.25rem; transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease; }
+.category-grid a:hover { transform: translateY(-5px); border-color: #a9c3b9; box-shadow: 0 12px 24px rgb(20 68 51 / 10%); }
+.category-grid span { display: grid; place-items: center; width: 4.2rem; height: 4.2rem; margin-bottom: .6rem; background: #edf4e5; border-radius: 50%; font-size: 2rem; }
+.category-grid a:nth-child(2n) span { background: #e7f0f4; }
+.category-grid a:nth-child(3n) span { background: #fff0d8; }
+.category-grid small { color: var(--muted); font-size: .68rem; }
+.promo-grid { display: grid; grid-template-columns: 1.2fr .8fr; gap: 1rem; padding-top: 4rem; }
+.promo { display: flex; align-items: center; justify-content: space-between; min-height: 13rem; overflow: hidden; padding: 2rem 2.4rem; border-radius: 1.5rem; }
+.promo p { margin: 0; font-size: .75rem; opacity: .75; }
+.promo h2 { max-width: 18ch; margin: .15rem 0 1rem; font-size: clamp(1.35rem, 3vw, 2.2rem); line-height: 1.35; }
+.promo a { border-bottom: 1px solid currentColor; font-size: .82rem; }
+.promo > span { font-size: clamp(4rem, 9vw, 7rem); transform: rotate(-8deg); }
+.promo-green { color: white; background: var(--green); }
+.promo-orange { background: #f5d7a8; }
+
+.carousel-controls { display: flex; gap: .5rem; direction: rtl; }
+.carousel-controls a { display: grid; place-items: center; width: 2.6rem; height: 2.6rem; background: white; border: 1px solid var(--line); border-radius: 50%; transition: color .2s ease, background .2s ease; }
+.carousel-controls a:hover { color: white; background: var(--green); }
+.product-track { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(12.5rem, 1fr); grid-template-rows: 1fr; gap: 1rem; overflow-x: auto; overscroll-behavior-inline: contain; padding: .5rem .3rem 1.5rem; scroll-snap-type: inline mandatory; scrollbar-color: var(--green-2) #e9ece6; scrollbar-width: thin; }
+.product-card { min-width: 0; overflow: hidden; background: white; border: 1px solid var(--line); border-radius: 1.25rem; scroll-snap-align: start; transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease; }
+.product-card:hover, .product-card:focus-within { z-index: 2; border-color: #abc6bb; box-shadow: 0 16px 30px rgb(24 63 49 / 14%); transform: translateY(-6px); }
+.product-card:target { border-color: var(--orange); box-shadow: 0 0 0 4px rgb(240 163 64 / 18%); }
+.product-media { position: relative; display: grid; place-items: center; min-height: 10.5rem; margin: .55rem; background: #f8e1dc; border-radius: .9rem; font-size: 5rem; }
+.product-media span[role="img"] { filter: drop-shadow(0 10px 9px rgb(30 40 35 / 13%)); transition: transform .25s ease; }
+.product-card:hover .product-media span[role="img"] { transform: rotate(-6deg) scale(1.08); }
+.product-media.milk, .product-media.cheese, .product-media.drink { background: #e3eef8; }
+.product-media.banana, .product-media.butter { background: #fff0c8; }
+.product-media.cucumber, .product-media.yogurt { background: #dcefe8; }
+.product-media.chicken, .product-media.icecream { background: #f8deda; }
+.product-media.cookie, .product-media.egg { background: #eee2f6; }
+.discount { position: absolute; top: .65rem; right: .65rem; padding: .15rem .45rem; color: white; background: #e4502c; border-radius: 999px; font-size: .68rem; }
+.product-info { padding: .5rem 1rem 1.1rem; }
+.product-info small { color: var(--muted); font-size: .7rem; }
+.product-info h3 { min-height: 3.1rem; margin: .2rem 0 .45rem; font-size: .95rem; line-height: 1.55; }
+.product-info del, .price-spacer { display: block; min-height: 1.5rem; color: #8b9993; font-size: .68rem; }
+.price-spacer { visibility: hidden; }
+.product-info p { margin: 0 0 .75rem; font-size: .72rem; }
+.product-info p strong { font-size: 1rem; }
+.product-info button { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 2.8rem; padding: .5rem .8rem; color: white; background: var(--green); border: 0; border-radius: .75rem; cursor: pointer; transition: background .2s ease, transform .12s ease; }
+.product-info button:hover { background: var(--green-2); }
+.product-info button:active { transform: scale(.96); }
+
+.story { display: grid; grid-template-columns: .9fr 1.1fr; align-items: center; gap: clamp(2rem, 6vw, 5rem); margin-top: 6rem; padding: clamp(1rem, 3vw, 2rem); background: #f5efe5; border-radius: 2rem; }
+.story-image { position: relative; }
+.story-image img { width: 100%; min-height: 22rem; object-fit: cover; border-radius: 1.35rem; }
+.story-image span { position: absolute; bottom: 1rem; right: 1rem; padding: .5rem .85rem; color: white; background: var(--green); border-radius: 999px; font-size: .72rem; }
+.story h2 { max-width: 16ch; margin: .2rem 0 1rem; font-size: clamp(1.8rem, 4vw, 3.3rem); line-height: 1.3; }
+.story p:not(.eyebrow) { max-width: 48ch; color: var(--muted); }
+.story a { display: inline-block; margin-top: 1rem; color: var(--green-2); border-bottom: 2px solid currentColor; }
+.anchor-sections { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; padding-top: 5rem; }
+.anchor-sections article { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 1rem; padding: 1.35rem; background: white; border: 1px solid var(--line); border-radius: 1.25rem; }
+.anchor-sections article:target { border-color: var(--orange); box-shadow: 0 0 0 4px rgb(240 163 64 / 18%); }
+.anchor-sections article > span { font-size: 2.3rem; }
+.anchor-sections h2 { margin: 0; font-size: 1.1rem; }
+.anchor-sections p { margin: .2rem 0 0; color: var(--muted); font-size: .75rem; }
+.anchor-sections a { color: var(--green-2); font-size: .75rem; }
+
+footer { color: #dce8e2; background: #102b21; }
+.footer-grid { display: grid; grid-template-columns: 1.5fr repeat(3, 1fr); gap: 3rem; max-width: 75rem; margin-inline: auto; padding: 4rem 1.25rem 3rem; }
+footer h2 { margin: 0 0 .8rem; color: white; font-size: .95rem; }
+.footer-brand { font-size: 1.6rem; }
+footer p, footer address { max-width: 30rem; margin: 0; color: #aebfb8; font-size: .78rem; font-style: normal; }
+footer nav { display: flex; flex-direction: column; align-items: start; gap: .45rem; }
+footer nav a, .back-to-top { color: #b9cac3; font-size: .75rem; }
+footer a:hover { color: white; }
+.back-to-top { display: inline-block; margin-top: 1rem; color: #f3bb61; }
+.copyright { max-width: 75rem; margin-inline: auto; padding: 1.1rem 1.25rem; border-top: 1px solid rgb(255 255 255 / 10%); }
+
+@keyframes float { 0%, 100% { transform: translateY(0) rotate(0); } 50% { transform: translateY(-10px) rotate(4deg); } }
+@keyframes announcement-flow { to { background-position: -200% 0; } }
+@keyframes menu-open { from { opacity: 0; transform: translateY(-8px) scale(.98); } to { opacity: 1; transform: translateY(0) scale(1); } }
+
+@media (min-width: 62rem) { .product-track { grid-auto-columns: calc((100% - 4rem) / 5); } }
+
+@media (max-width: 54rem) {
+  .header-shell { grid-template-columns: 1fr auto; gap: .75rem; }
+  .search { grid-column: 1 / -1; grid-row: 2; }
+  .desktop-menu { display: none; }
+  .menu { position: relative; display: block; padding-bottom: .7rem; }
+  .menu summary { display: flex; align-items: center; gap: .5rem; width: fit-content; min-height: 2.75rem; padding: .45rem .75rem; cursor: pointer; list-style: none; border: 1px solid var(--line); border-radius: .7rem; }
+  .menu summary::-webkit-details-marker { display: none; }
+  .menu nav { position: absolute; top: calc(100% - .35rem); right: 1.25rem; left: 1.25rem; display: grid; align-content: start; justify-content: stretch; gap: 0; max-height: min(70vh, 30rem); overflow-y: auto; padding: .7rem; background: var(--paper); border: 1px solid var(--line); border-radius: 1rem; box-shadow: var(--shadow); transform-origin: top; animation: menu-open .18s ease-out both; }
+  .menu:not([open]) nav { display: none; }
+  .menu nav a { min-height: 2.8rem; padding: .55rem .7rem; border-bottom: 1px solid var(--line); }
+  .menu nav a:last-child { border-bottom: 0; }
+  .hero { grid-template-columns: 1fr; }
+  .hero-visual { min-height: 24rem; margin-top: 2rem; }
+  .category-grid { grid-template-columns: repeat(3, 1fr); }
+  .promo-grid { grid-template-columns: 1fr; }
+  .story { grid-template-columns: 1fr; }
+  .footer-grid { grid-template-columns: repeat(2, 1fr); }
+}
+
+@media (max-width: 38rem) {
+  html { scroll-padding-top: 13rem; }
+  .announcement { font-size: .67rem; }
+  .header-shell { padding: .65rem 1rem; }
+  .brand-mark { width: 2.6rem; height: 2.6rem; }
+  .brand strong { font-size: 1.05rem; }
+  .brand small, .cart span { display: none; }
+  .menu { padding-inline: 1rem; }
+  main { padding-inline: .85rem; }
+  .hero { min-height: auto; padding: 2rem 1.15rem; border-radius: 1.3rem; }
+  h1 { font-size: clamp(2.25rem, 12vw, 3.5rem); }
+  .hero-visual { min-height: 19rem; }
+  .hero-visual img { inset: 5% 7% auto auto; width: 86%; height: 78%; }
+  .shape { width: 3.35rem; height: 3.35rem; font-size: 1.65rem; }
+  .hero-features { gap: .35rem .8rem; }
+  .section-heading { align-items: start; }
+  .section-heading > p { display: none; }
+  .category-grid { grid-template-columns: repeat(2, 1fr); }
+  .category-grid a { padding: 1rem .35rem; }
+  .promo { min-height: 11rem; padding: 1.4rem; }
+  .promo > span { font-size: 4rem; }
+  .product-track { grid-auto-columns: minmax(76vw, 18rem); }
+  .story { margin-top: 4rem; padding: .75rem .75rem 1.5rem; }
+  .story-image img { min-height: 16rem; }
+  .story > div:last-child { padding-inline: .5rem; }
+  .anchor-sections { grid-template-columns: 1fr; }
+  .anchor-sections article { grid-template-columns: auto 1fr; }
+  .anchor-sections article > a { grid-column: 2; }
+  .footer-grid { grid-template-columns: 1fr; gap: 2rem; }
+}
+
+@media (prefers-color-scheme: dark) {
+  :root { --ink: #e7f1ec; --muted: #a9bbb3; --paper: #0c1914; --surface: #17251f; --line: #2b4037; --shadow: 0 18px 45px rgb(0 0 0 / 28%); }
+  .site-header { background: rgb(12 25 20 / 94%); }
+  .hero { background: #20382b; }
+  .hero::before { opacity: .2; }
+  .hero-copy > p:not(.eyebrow), .hero-features { color: #bfd0c7; }
+  .category-grid a, .product-card, .carousel-controls a, .anchor-sections article, .menu nav { background: #12221b; }
+  .promo-orange { color: #17322a; }
+  .story { background: #182820; }
+  footer { background: #07100c; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  html { scroll-behavior: auto; }
+  *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
 }
